FROM php:8.4-fpm-bookworm

# ==============================================================================
# BEDROCK-CLI: STUNNING DOCKERFILE FOR WORDPRESS/BEDROCK
# Optimized for: Production, cPanel, and Legacy Environments
# ==============================================================================

# 1. CRITICAL FIX: Disable XZ Sandbox
# Workaround for "xz: Failed to enable the sandbox" on older kernels/cPanel seccomp.

# 2. DESIGN SYSTEM: mlocati extension installer
# We use pre-compiled binaries to avoid heavy compilation in restricted environments.
COPY --from=mlocati/php-extension-installer /usr/bin/install-php-extensions /usr/local/bin/

# Instalar extensiones requeridas por WordPress + Bedrock
RUN install-php-extensions \
    mysqli \
    pdo_mysql \
    opcache \
    intl \
    bcmath \
    zip \
    exif \
    gd \
    imagick \
    redis \
    pcntl \
    calendar \
    soap \
    && echo "variables_order = EGPCS" > /usr/local/etc/php/conf.d/variables_order.ini \
    @composer

# 3. CORE UTILITIES
# 'mariadb-client' is native and fully compatible with MySQL in Debian Bookworm.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    git \
    unzip \
    mariadb-client \
    less \
    nano \
    && rm -rf /var/lib/apt/lists/*

# 4. POWER TOOLS: WP-CLI
# The standard CLI tool for WordPress management.
RUN curl -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
    && chmod +x wp-cli.phar \
    && mv wp-cli.phar /usr/local/bin/wp

# 5. PHP & FPM CRAFTSMANSHIP
# Implementing premium performance settings for consistent experience.
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" && \
    sed -i 's/memory_limit = .*/memory_limit = 512M/' "$PHP_INI_DIR/php.ini" && \
    sed -i 's/upload_max_filesize = .*/upload_max_filesize = 64M/' "$PHP_INI_DIR/php.ini" && \
    sed -i 's/post_max_size = .*/post_max_size = 64M/' "$PHP_INI_DIR/php.ini" && \
    sed -i 's/max_execution_time = .*/max_execution_time = 300/' "$PHP_INI_DIR/php.ini"

# Advanced FPM tuning for high concurrency
RUN echo "pm.max_children = 50" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.start_servers = 10" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.min_spare_servers = 5" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.max_spare_servers = 20" >> /usr/local/etc/php-fpm.d/www.conf

# 6. WORKSPACE & PERMISSIONS
WORKDIR /var/www/html

# Copy application files with proper ownership in mind
COPY . /var/www/html

# Ensure storage directories exist and are writable by the web server
RUN mkdir -p /var/www/html/storage/framework/{cache,views,sessions,testing} && \
    chown -R www-data:www-data /var/www/html/storage && \
    chmod -R 775 /var/www/html/storage

# 7. BOOTSTRAP
ENTRYPOINT ["docker-php-entrypoint"]
CMD ["php-fpm"]

EXPOSE 9000
