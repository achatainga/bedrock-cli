FROM php:8.4-fpm

RUN apt-get update && \
    apt-get install -y zlib1g-dev libzip-dev wget build-essential mariadb-client unzip python3 python3-pip zip git subversion curl \
    libfreetype6-dev libjpeg62-turbo-dev libpng-dev && \
    rm -rf /var/lib/apt/lists/*

RUN php -r "copy('https://getcomposer.org/installer', 'composer-setup.php');" \
    && php composer-setup.php --install-dir=/usr/local/bin --filename=composer \
    && rm composer-setup.php

RUN curl -O https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
    && chmod +x wp-cli.phar \
    && mv wp-cli.phar /usr/local/bin/wp

RUN wget --timeout=600 https://www.php.net/distributions/php-8.4.0.tar.gz -O /tmp/php.tar.gz && \
    tar -xzf /tmp/php.tar.gz -C /tmp && \
    rm /tmp/php.tar.gz

WORKDIR /tmp/php-8.4.0/ext/zip

RUN phpize && ./configure --with-zlib=/usr && make && make install

RUN rm -rf /tmp/php-8.4.0

RUN echo "extension=zip.so" > /usr/local/etc/php/conf.d/docker-php-ext-zip.ini

RUN docker-php-ext-configure pdo_mysql --with-pdo-mysql=mysqlnd && \
    docker-php-ext-configure mysqli --with-mysqli=mysqlnd && \
    docker-php-ext-install pdo_mysql mysqli pdo

RUN docker-php-ext-configure gd --with-freetype --with-jpeg && \
    docker-php-ext-install -j$(nproc) gd

RUN echo '#!/bin/bash' > /usr/local/bin/mariadb-wrapper.sh && \
    echo 'args=()' >> /usr/local/bin/mariadb-wrapper.sh && \
    echo 'for arg in "$@"; do' >> /usr/local/bin/mariadb-wrapper.sh && \
    echo '  [[ "$arg" != "--no-defaults" ]] && args+=("$arg")' >> /usr/local/bin/mariadb-wrapper.sh && \
    echo 'done' >> /usr/local/bin/mariadb-wrapper.sh && \
    echo 'exec "/usr/bin/mariadb.real" --skip-ssl "${args[@]}"' >> /usr/local/bin/mariadb-wrapper.sh && \
    echo '#!/bin/bash' > /usr/local/bin/mariadb-check-wrapper.sh && \
    echo 'args=()' >> /usr/local/bin/mariadb-check-wrapper.sh && \
    echo 'for arg in "$@"; do' >> /usr/local/bin/mariadb-check-wrapper.sh && \
    echo '  [[ "$arg" != "--no-defaults" ]] && args+=("$arg")' >> /usr/local/bin/mariadb-check-wrapper.sh && \
    echo 'done' >> /usr/local/bin/mariadb-check-wrapper.sh && \
    echo 'exec "/usr/bin/mariadb-check.real" --skip-ssl "${args[@]}"' >> /usr/local/bin/mariadb-check-wrapper.sh && \
    echo '#!/bin/bash' > /usr/local/bin/mariadb-dump-wrapper.sh && \
    echo 'args=()' >> /usr/local/bin/mariadb-dump-wrapper.sh && \
    echo 'for arg in "$@"; do' >> /usr/local/bin/mariadb-dump-wrapper.sh && \
    echo '  [[ "$arg" != "--no-defaults" ]] && args+=("$arg")' >> /usr/local/bin/mariadb-dump-wrapper.sh && \
    echo 'done' >> /usr/local/bin/mariadb-dump-wrapper.sh && \
    echo 'exec "/usr/bin/mariadb-dump.real" --skip-ssl "${args[@]}"' >> /usr/local/bin/mariadb-dump-wrapper.sh && \
    chmod +x /usr/local/bin/mariadb-wrapper.sh /usr/local/bin/mariadb-check-wrapper.sh /usr/local/bin/mariadb-dump-wrapper.sh && \
    mv /usr/bin/mariadb /usr/bin/mariadb.real && \
    mv /usr/bin/mariadb-check /usr/bin/mariadb-check.real && \
    mv /usr/bin/mariadb-dump /usr/bin/mariadb-dump.real && \
    rm -f /usr/bin/mysql /usr/bin/mysqlcheck /usr/bin/mysqldump && \
    ln -s /usr/local/bin/mariadb-wrapper.sh /usr/bin/mariadb && \
    ln -s /usr/local/bin/mariadb-check-wrapper.sh /usr/bin/mariadb-check && \
    ln -s /usr/local/bin/mariadb-dump-wrapper.sh /usr/bin/mariadb-dump && \
    ln -s /usr/bin/mariadb /usr/bin/mysql && \
    ln -s /usr/bin/mariadb-check /usr/bin/mysqlcheck && \
    ln -s /usr/bin/mariadb-dump /usr/bin/mysqldump

WORKDIR /var/www/html

COPY . /var/www/html

RUN echo "pm.max_children = 50" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.start_servers = 10" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.min_spare_servers = 5" >> /usr/local/etc/php-fpm.d/www.conf && \
    echo "pm.max_spare_servers = 20" >> /usr/local/etc/php-fpm.d/www.conf

# Configuración PHP para uploads grandes
RUN echo "upload_max_filesize = 50M" >> /usr/local/etc/php/conf.d/uploads.ini && \
    echo "post_max_size = 50M" >> /usr/local/etc/php/conf.d/uploads.ini && \
    echo "memory_limit = 512M" >> /usr/local/etc/php/conf.d/uploads.ini && \
    echo "max_execution_time = 300" >> /usr/local/etc/php/conf.d/uploads.ini

RUN mkdir -p /var/www/html/storage/framework/{cache,views,sessions,testing} && \
    chown -R www-data:www-data /var/www/html/storage && \
    chmod -R 775 /var/www/html/storage

ENTRYPOINT ["docker-php-entrypoint"]

CMD ["php-fpm"]

EXPOSE 9000
