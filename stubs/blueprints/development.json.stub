{
  "name": "{{PROJECT_NAME}} - Development",
  "environment": "development",
  "database": {
    "import": "snapshots/development.sql"
  },
  "wordpress": {
    "url": "{{DEV_URL}}",
    "title": "{{PROJECT_NAME}} (Dev)",
    "admin_user": "admin",
    "admin_email": "dev@localhost.test"
  },
  "plugins": {
    "activate": "all",
    "licenses": {
      "acf-pro": "{{ACF_PRO_LICENSE}}",
      "gravityforms": "{{GRAVITY_FORMS_LICENSE}}"
    }
  },
  "theme": {
    "activate": true,
    "license": "{{THEME_LICENSE}}"
  },
  "seeders": [
    "CoreSeeder",
    "WooCommerceSeeder",
    "ThemeSeeder",
    "PluginsSeeder",
    "ProductsSeeder"
  ],
  "options": {
    "permalink_structure": "/%postname%/",
    "timezone_string": "America/New_York",
    "blog_public": "0",
    "woocommerce_demo_store": "yes"
  }
}
