{
  "name": "{{PROJECT_NAME}} - Staging",
  "environment": "staging",
  "database": {
    "import": "snapshots/staging.sql"
  },
  "wordpress": {
    "url": "{{STAGING_URL}}",
    "title": "{{PROJECT_NAME}} (Staging)",
    "admin_user": "{{ADMIN_USER}}",
    "admin_email": "{{ADMIN_EMAIL}}"
  },
  "plugins": {
    "activate": "all",
    "licenses": {
      "acf-pro": "{{ACF_PRO_LICENSE}}",
      "gravityforms": "{{GRAVITY_FORMS_LICENSE}}"
    }
  },
  "theme": {
    "activate": true,
    "license": "{{THEME_LICENSE}}"
  },
  "seeders": [
    "CoreSeeder",
    "WooCommerceSeeder",
    "ThemeSeeder"
  ],
  "options": {
    "permalink_structure": "/%postname%/",
    "timezone_string": "America/New_York",
    "blog_public": "0"
  }
}
