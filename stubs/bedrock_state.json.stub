{
  "version": "1.0",
  "project_name": "{{PROJECT_NAME}}",
  "created_at": "{{CREATED_AT}}",
  "current_step": 1,
  "wizard_mode": true,
  "steps": [
    {
      "id": 1,
      "title": "Iniciar Docker",
      "description": "Levanta los contenedores (web, nginx, mysql, redis) ejecutando:\n\ndocker-compose up -d\n\nEsto iniciará todos los servicios necesarios para el proyecto.",
      "command": "docker-compose up -d",
      "menu_item": "D",
      "completed": false,
      "skippable": false
    },
    {
      "id": 2,
      "title": "Instalar WordPress",
      "description": "Instala WordPress Core en la base de datos ejecutando:\n\ndocker-compose exec web wp core install \\\n  --url=http://localhost:{{HTTP_PORT}} \\\n  --title=\"Mi Sitio\" \\\n  --admin_user=admin \\\n  --admin_password=admin \\\n  --admin_email=admin@example.com\n\nEsto creará las tablas de WordPress y el usuario administrador.",
      "command": "docker-compose exec web wp core install --url=http://localhost:{{HTTP_PORT}} --title=\"Mi Sitio\" --admin_user=admin --admin_password=admin --admin_email=admin@example.com",
      "menu_item": "I",
      "completed": false,
      "skippable": false
    },
    {
      "id": 3,
      "title": "Activar Plugins",
      "description": "Activa los plugins instalados desde el profile.\n\nUsa el menú [P] Plugins → Activar plugins\n\nO ejecuta manualmente:\ndocker-compose exec web wp plugin activate --all",
      "menu_item": "P",
      "completed": false,
      "skippable": true,
      "condition": "{{HAS_PLUGINS}}"
    },
    {
      "id": 4,
      "title": "Activar Tema",
      "description": "Activa el tema configurado en el profile.\n\nUsa el menú [T] Themes → Activar tema\n\nO ejecuta manualmente:\ndocker-compose exec web wp theme activate {{THEME_NAME}}",
      "menu_item": "T",
      "completed": false,
      "skippable": true,
      "condition": "{{HAS_THEME}}"
    },
    {
      "id": 5,
      "title": "Configurar Acorn",
      "description": "Inicializa Acorn (storage, providers, config) ejecutando:\n\ndocker-compose exec web wp plugin activate acorn\ndocker-compose exec web wp acorn acorn:init storage\ndocker-compose exec web wp acorn vendor:publish --tag=acorn\n\nEsto creará automáticamente:\n• app/Providers/AppServiceProvider.php\n• app/Console/Commands/\n• config/app.php, config/assets.php, config/view.php\n• storage/ (logs, cache, framework)",
      "menu_item": "A",
      "completed": false,
      "skippable": true,
      "condition": "{{HAS_ACORN}}"
    },
    {
      "id": 6,
      "title": "Ejecutar Seeders (Opcional)",
      "description": "Ejecuta los seeders para poblar la base de datos con datos de prueba.\n\nUsa el menú [S] Seed → Ejecutar seeders\n\nO ejecuta manualmente:\ndocker-compose exec web wp eval-file database/seeders/DatabaseSeeder.php",
      "menu_item": "S",
      "completed": false,
      "skippable": true
    }
  ]
}
