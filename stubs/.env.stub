DB_NAME="{{DB_NAME}}"
DB_USER="{{DB_USER}}"
DB_PASSWORD="{{DB_PASSWORD}}"
DB_HOST='mysql'

WP_ENV='development'{{WP_PORT_LINE}}
WP_HOME='{{WP_HOME_URL}}'
WP_SITEURL="${WP_HOME}/wp"

AUTH_KEY='{{AUTH_KEY}}'
SECURE_AUTH_KEY='{{SECURE_AUTH_KEY}}'
LOGGED_IN_KEY='{{LOGGED_IN_KEY}}'
NONCE_KEY='{{NONCE_KEY}}'
AUTH_SALT='{{AUTH_SALT}}'
SECURE_AUTH_SALT='{{SECURE_AUTH_SALT}}'
LOGGED_IN_SALT='{{LOGGED_IN_SALT}}'
NONCE_SALT='{{NONCE_SALT}}'

# Acorn
APP_KEY='{{APP_KEY}}'

# Redis
WP_CACHE=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0
WP_REDIS_PREFIX='wp'
