DB_NAME='{{DB_NAME}}'
DB_USER='{{DB_USER}}'
DB_PASSWORD='{{DB_PASSWORD}}'
DB_HOST='{{DB_HOST}}'{{DB_PORT_LINE}}

WP_ENV='development'{{WP_PORT_LINE}}
WP_HOME="{{WP_HOME_URL}}"
WP_SITEURL="${WP_HOME}/wp"

AUTH_KEY='{{AUTH_KEY}}'
SECURE_AUTH_KEY='{{SECURE_AUTH_KEY}}'
LOGGED_IN_KEY='{{LOGGED_IN_KEY}}'
NONCE_KEY='{{NONCE_KEY}}'
AUTH_SALT='{{AUTH_SALT}}'
SECURE_AUTH_SALT='{{SECURE_AUTH_SALT}}'
LOGGED_IN_SALT='{{LOGGED_IN_SALT}}'
NONCE_SALT='{{NONCE_SALT}}'

# Debug
WP_DEBUG=false
WP_DEBUG_DISPLAY=false
WP_DEBUG_LOG=false

# Acorn
APP_KEY='{{APP_KEY}}'
APP_URL={{WP_HOME_URL}}

# Redis
WP_CACHE={{WP_CACHE}}
REDIS_HOST={{REDIS_HOST}}{{REDIS_PORT_LINE}}
REDIS_PASSWORD=
REDIS_DATABASE=0
WP_REDIS_PREFIX='wp'
