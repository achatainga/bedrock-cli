services:
  web:
    build:
      context: .
      dockerfile: Dockerfile.web
    container_name: {{PROJECT_NAME}}_web
    working_dir: /var/www/html
    environment:
      - MYSQL_PWD={{DB_PASSWORD}}
      - WP_CLI_ALLOW_ROOT=1
      - WP_CLI_STRICT_ARGS_MODE=0
    volumes:
      - ./:/var/www/html
      - ./docker/mysql/client.cnf:/etc/mysql/conf.d/client.cnf:ro
      - ./auth.json:/root/.composer/auth.json:ro
    depends_on:
      - mysql

  nginx:
    image: nginx:alpine
    container_name: {{PROJECT_NAME}}_nginx
    ports:
      - "{{HTTP_PORT}}:80"
    volumes:
      - ./:/var/www/html
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - web

  mysql:
    image: mysql:8.0
    container_name: {{PROJECT_NAME}}_mysql
    restart: always
    command: --skip-ssl --require_secure_transport=OFF --lower_case_table_names=0 --default-authentication-plugin=mysql_native_password
    environment:
      MYSQL_ROOT_PASSWORD: {{DB_PASSWORD}}
      MYSQL_DATABASE: {{DB_NAME}}
    ports:
      - "{{MYSQL_PORT}}:3306"
    volumes:
      - dbdata:/var/lib/mysql
      - ./docker/mysql/my.cnf:/etc/mysql/conf.d/ssl.cnf:ro

  worker:
    build:
      context: .
      dockerfile: Dockerfile.web
    container_name: {{PROJECT_NAME}}_worker
    working_dir: /var/www/html
    restart: unless-stopped
    command: >
      bash -c "while true; do
        wp cron event run --due-now --path=/var/www/html/web/wp --allow-root || true;
        wp action-scheduler run --batch-size=50 --path=/var/www/html/web/wp --allow-root || true;
        sleep 60;
      done"
    environment:
      - MYSQL_PWD={{DB_PASSWORD}}
      - WP_CLI_ALLOW_ROOT=1
      - WP_CLI_STRICT_ARGS_MODE=0
    volumes:
      - ./:/var/www/html
      - ./docker/mysql/client.cnf:/etc/mysql/conf.d/client.cnf:ro
    depends_on:
      - mysql
      - redis
      - web

  redis:
    image: redis:7-alpine
    container_name: {{PROJECT_NAME}}_redis
    restart: always
    command: redis-server --maxmemory 256mb --maxmemory-policy allkeys-lru
    ports:
      - "{{REDIS_PORT}}:6379"
    volumes:
      - redisdata:/data

volumes:
  dbdata:
  redisdata:
