services:
  web:
    build:
      context: .
      dockerfile: Dockerfile.web
    container_name: {{PROJECT_NAME}}_web
    working_dir: /var/www/html
    mem_limit: 1024m
    mem_reservation: 512m
    pids_limit: 100
    environment:
      - MYSQL_PWD={{DB_PASSWORD}}
      - WP_CLI_ALLOW_ROOT=1
      - WP_CLI_STRICT_ARGS_MODE=0
    volumes:
      - ./:/var/www/html
      - ./docker/mysql/client.cnf:/etc/mysql/conf.d/client.cnf:ro
      - ./docker/php-fpm/zz-tuning.conf:/usr/local/etc/php-fpm.d/zz-tuning.conf:ro
      - ./auth.json:/root/.composer/auth.json:ro
    depends_on:
      - mysql

  nginx:
    image: nginx:alpine
    container_name: {{PROJECT_NAME}}_nginx
    mem_limit: 64m
    pids_limit: 50
    ports:
      - "{{NGINX_PORT_BINDING}}:80"
    volumes:
      - ./:/var/www/html
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - web

  mysql:
    image: mysql:8.0
    container_name: {{PROJECT_NAME}}_mysql
    restart: always
    mem_limit: 768m
    mem_reservation: 512m
    pids_limit: 200
    command: --lower_case_table_names=0 --default-authentication-plugin=mysql_native_password
    environment:
      MYSQL_ROOT_PASSWORD: {{MYSQL_ROOT_PASSWORD}}
      MYSQL_DATABASE: {{DB_NAME}}
{{MYSQL_USER_ENV_BLOCK}}
    ports:
      - "{{MYSQL_PORT_BINDING}}:3306"
    volumes:
      - dbdata:/var/lib/mysql
      - ./docker/mysql/my.cnf:/etc/mysql/conf.d/ssl.cnf:ro

  worker:
    build:
      context: .
      dockerfile: Dockerfile.web
    container_name: {{PROJECT_NAME}}_worker
    working_dir: /var/www/html
    restart: unless-stopped
    mem_limit: 384m
    mem_reservation: 128m
    pids_limit: 50
    command: >
      bash -c "while true; do
        wp cron event run --due-now --path=/var/www/html/web/wp --allow-root || true;
        wp action-scheduler run --batch-size=50 --path=/var/www/html/web/wp --allow-root || true;
        sleep 300;
      done"
    environment:
      - MYSQL_PWD={{DB_PASSWORD}}
      - WP_CLI_ALLOW_ROOT=1
      - WP_CLI_STRICT_ARGS_MODE=0
    volumes:
      - ./:/var/www/html
      - ./docker/mysql/client.cnf:/etc/mysql/conf.d/client.cnf:ro
    depends_on:
      - mysql
      - redis
      - web

  redis:
    image: redis:7-alpine
    container_name: {{PROJECT_NAME}}_redis
    restart: always
    mem_limit: 320m
    pids_limit: 50
    command: redis-server --requirepass "${REDIS_PASSWORD}" --maxmemory 256mb --maxmemory-policy allkeys-lru --save ""
    environment:
      - REDIS_PASSWORD={{REDIS_PASSWORD}}
    ports:
      - "{{REDIS_PORT_BINDING}}:6379"
    volumes:
      - redisdata:/data
    healthcheck:
      test: ["CMD", "redis-cli", "-a", "{{REDIS_PASSWORD}}", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  dbdata:
  redisdata:
