
# ==============================================================================
# BEDROCK-CLI: PREMIUM DOCKER COMPOSE STACK
# Optimized for high-performance WordPress/Bedrock development.
# ==============================================================================

services:
  web:
    build:
      context: .
      dockerfile: Dockerfile.web
    container_name: {{PROJECT_NAME}}_web
    working_dir: /var/www/html
    env_file: .env
    environment:
      - MYSQL_PWD={{DB_PASSWORD}}
      - WP_CLI_ALLOW_ROOT=1
      - WP_CLI_STRICT_ARGS_MODE=0
    volumes:
      - ./:/var/www/html
      - ./docker/mysql/client.cnf:/etc/mysql/conf.d/client.cnf:ro
      - ./auth.json:/root/.composer/auth.json:ro
    depends_on:
      - mysql

  nginx:
    image: nginx:stable-alpine
    container_name: {{PROJECT_NAME}}_nginx
    ports:
      - "{{HTTP_PORT}}:80"
    volumes:
      - ./:/var/www/html
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - web

  mysql:
    image: mysql:8.0 # PREMIUM UPGRADE: Using modern MySQL 8.0
    container_name: {{PROJECT_NAME}}_mysql
    restart: always
    # Added mysql_native_password for maximum compatibility with older drivers and WP tools
    command: --skip-ssl --require_secure_transport=OFF --default-authentication-plugin=mysql_native_password
    environment:
      MYSQL_ROOT_PASSWORD: {{DB_PASSWORD}}
      MYSQL_DATABASE: {{DB_NAME}}
    ports:
      - "{{MYSQL_PORT}}:3306"
    volumes:
      - dbdata:/var/lib/mysql
      - ./docker/mysql/my.cnf:/etc/mysql/conf.d/ssl.cnf:ro

  redis:
    image: redis:7-alpine
    container_name: {{PROJECT_NAME}}_redis
    restart: always
    command: redis-server --maxmemory 256mb --maxmemory-policy allkeys-lru
    ports:
      - "{{REDIS_PORT}}:6379"
    volumes:
      - redisdata:/data

volumes:
  dbdata:
  redisdata:
