<?php

/**
 * Your base production configuration goes in this file. Environment-specific
 * overrides go in their respective config/environments/{{WP_ENV}}.php file.
 */

use Roots\WPConfig\Config;
use function Env\env;

Env\Env::$options = 31;

/**
 * Directory containing all of the site's files
 */
$root_dir = dirname(__DIR__);

/**
 * Document Root
 */
$webroot_dir = $root_dir . '/web';

/**
 * Use Dotenv to set required environment variables and load .env file in root
 */
if (file_exists($root_dir . '/.env')) {
    $env_files = file_exists($root_dir . '/.env.local')
        ? ['.env', '.env.local']
        : ['.env'];

    $repository = Dotenv\Repository\RepositoryBuilder::createWithNoAdapters()
        ->addAdapter(Dotenv\Repository\Adapter\EnvConstAdapter::class)
        ->addAdapter(Dotenv\Repository\Adapter\PutenvAdapter::class)
        ->immutable()
        ->make();

    $dotenv = Dotenv\Dotenv::create($repository, $root_dir, $env_files, false);
    $dotenv->load();

    $dotenv->required(['WP_HOME', 'WP_SITEURL']);
    if (!env('DATABASE_URL')) {
        $dotenv->required(['DB_NAME', 'DB_USER', 'DB_PASSWORD']);
    }
}

/**
 * Set up our global environment constant and load its config first
 */
if (!defined('WP_ENV')) {
    define('WP_ENV', env('WP_ENV') ?: 'production');
}

/**
 * Infer WP_ENVIRONMENT_TYPE based on WP_ENV
 */
if (!defined('WP_ENVIRONMENT_TYPE') && in_array(WP_ENV, ['production', 'staging', 'development', 'local'])) {
    Config::define('WP_ENVIRONMENT_TYPE', WP_ENV);
}

/**
 * URLs
 */
if (!defined('WP_HOME')) {
    Config::define('WP_HOME', env('WP_HOME'));
}
if (!defined('WP_SITEURL')) {
    Config::define('WP_SITEURL', env('WP_SITEURL'));
}

/**
 * Custom Content Directory
 */
if (!defined('CONTENT_DIR')) {
    Config::define('CONTENT_DIR', '/app');
}
if (!defined('WP_CONTENT_DIR')) {
    Config::define('WP_CONTENT_DIR', $webroot_dir . Config::get('CONTENT_DIR'));
}
if (!defined('WP_CONTENT_URL')) {
    Config::define('WP_CONTENT_URL', Config::get('WP_HOME') . Config::get('CONTENT_DIR'));
}

/**
 * DB settings
 */
if (!defined('DB_NAME')) {
    Config::define('DB_NAME', env('DB_NAME'));
}
if (!defined('DB_USER')) {
    Config::define('DB_USER', env('DB_USER'));
}
if (!defined('DB_PASSWORD')) {
    Config::define('DB_PASSWORD', env('DB_PASSWORD'));
}
if (!defined('DB_HOST')) {
    $dbHost = env('DB_HOST') ?: 'localhost';
    $dbPort = env('DB_PORT');
    Config::define('DB_HOST', $dbPort ? "{$dbHost}:{$dbPort}" : $dbHost);
}
if (!defined('DB_CHARSET')) {
    Config::define('DB_CHARSET', 'utf8mb4');
}
if (!defined('DB_COLLATE')) {
    Config::define('DB_COLLATE', '');
}
if (!isset($table_prefix)) {
    $table_prefix = env('DB_PREFIX') ?: 'wp_';
}

if (env('DATABASE_URL')) {
    $dsn = (object) parse_url(env('DATABASE_URL'));
    if (!defined('DB_NAME')) Config::define('DB_NAME', substr($dsn->path, 1));
    if (!defined('DB_USER')) Config::define('DB_USER', $dsn->user);
    if (!defined('DB_PASSWORD')) Config::define('DB_PASSWORD', isset($dsn->pass) ? $dsn->pass : null);
    if (!defined('DB_HOST')) Config::define('DB_HOST', isset($dsn->port) ? "{$dsn->host}:{$dsn->port}" : $dsn->host);
}

/**
 * Authentication Unique Keys and Salts
 */
if (!defined('AUTH_KEY')) Config::define('AUTH_KEY', env('AUTH_KEY'));
if (!defined('SECURE_AUTH_KEY')) Config::define('SECURE_AUTH_KEY', env('SECURE_AUTH_KEY'));
if (!defined('LOGGED_IN_KEY')) Config::define('LOGGED_IN_KEY', env('LOGGED_IN_KEY'));
if (!defined('NONCE_KEY')) Config::define('NONCE_KEY', env('NONCE_KEY'));
if (!defined('AUTH_SALT')) Config::define('AUTH_SALT', env('AUTH_SALT'));
if (!defined('SECURE_AUTH_SALT')) Config::define('SECURE_AUTH_SALT', env('SECURE_AUTH_SALT'));
if (!defined('LOGGED_IN_SALT')) Config::define('LOGGED_IN_SALT', env('LOGGED_IN_SALT'));
if (!defined('NONCE_SALT')) Config::define('NONCE_SALT', env('NONCE_SALT'));

/**
 * WP Mail SMTP Configuration
 */
if (!defined('WPMS_ON')) Config::define('WPMS_ON', env('WPMS_ON') ?: false);
if (!defined('WPMS_MAILER')) Config::define('WPMS_MAILER', env('WPMS_MAILER') ?: 'smtp');
if (!defined('WPMS_SMTP_HOST')) Config::define('WPMS_SMTP_HOST', env('WPMS_SMTP_HOST'));
if (!defined('WPMS_SMTP_PORT')) Config::define('WPMS_SMTP_PORT', env('WPMS_SMTP_PORT') ?: 587);
if (!defined('WPMS_SMTP_AUTH')) Config::define('WPMS_SMTP_AUTH', env('WPMS_SMTP_AUTH') ?: true);
if (!defined('WPMS_SMTP_AUTOTLS')) Config::define('WPMS_SMTP_AUTOTLS', env('WPMS_SMTP_AUTOTLS') ?: true);
if (!defined('WPMS_SMTP_USER')) Config::define('WPMS_SMTP_USER', env('WPMS_SMTP_USER'));
if (!defined('WPMS_SMTP_PASS')) Config::define('WPMS_SMTP_PASS', env('WPMS_SMTP_PASS'));
if (!defined('WPMS_MAIL_FROM')) Config::define('WPMS_MAIL_FROM', env('WPMS_MAIL_FROM'));
if (!defined('WPMS_MAIL_FROM_NAME')) Config::define('WPMS_MAIL_FROM_NAME', env('WPMS_MAIL_FROM_NAME'));

/**
 * Custom Settings
 */
if (!defined('AUTOMATIC_UPDATER_DISABLED')) Config::define('AUTOMATIC_UPDATER_DISABLED', true);
if (!defined('DISABLE_WP_CRON')) Config::define('DISABLE_WP_CRON', env('DISABLE_WP_CRON') ?: false);

/**
 * Redis Object Cache Configuration
 */
if (!defined('WP_REDIS_HOST')) Config::define('WP_REDIS_HOST', env('REDIS_HOST') ?: 'redis');
if (!defined('WP_REDIS_PORT')) Config::define('WP_REDIS_PORT', env('REDIS_PORT') ?: 6379);
if (!defined('WP_REDIS_PASSWORD')) Config::define('WP_REDIS_PASSWORD', env('REDIS_PASSWORD') ?: '');
if (!defined('WP_REDIS_DATABASE')) Config::define('WP_REDIS_DATABASE', env('REDIS_DATABASE') ?: 0);
if (!defined('WP_REDIS_PREFIX')) Config::define('WP_REDIS_PREFIX', env('WP_REDIS_PREFIX') ?: 'dt24');

if (!defined('WP_CACHE')) {
    if (defined('WP_CLI') && WP_CLI) {
        Config::define('WP_CACHE', false);
    } else {
        Config::define('WP_CACHE', env('WP_CACHE') ?: false);
    }
}

// Memory limits
if (!defined('WP_MEMORY_LIMIT')) Config::define('WP_MEMORY_LIMIT', '512M');
if (!defined('WP_MAX_MEMORY_LIMIT')) Config::define('WP_MAX_MEMORY_LIMIT', '512M');

// Disable the plugin and theme file editor in the admin
if (!defined('DISALLOW_FILE_EDIT')) Config::define('DISALLOW_FILE_EDIT', true);

// Disable plugin and theme updates and installation from the admin
if (!defined('DISALLOW_FILE_MODS')) Config::define('DISALLOW_FILE_MODS', true);

// Force direct filesystem method to avoid "Could not access filesystem" errors in Docker
if (!defined('FS_METHOD')) Config::define('FS_METHOD', 'direct');

// Limit the number of post revisions
if (!defined('WP_POST_REVISIONS')) Config::define('WP_POST_REVISIONS', env('WP_POST_REVISIONS') ?? true);

// Disable script concatenation
if (!defined('CONCATENATE_SCRIPTS')) Config::define('CONCATENATE_SCRIPTS', false);

/**
 * Debugging Settings
 */
if (!defined('WP_DEBUG_DISPLAY')) Config::define('WP_DEBUG_DISPLAY', false);
if (!defined('WP_DEBUG_LOG')) Config::define('WP_DEBUG_LOG', false);
if (!defined('SCRIPT_DEBUG')) Config::define('SCRIPT_DEBUG', false);
ini_set('display_errors', '0');

/**
 * Allow WordPress to detect HTTPS when used behind a reverse proxy or a load balancer
 */
if (isset($_SERVER['HTTP_X_FORWARDED_PROTO']) && $_SERVER['HTTP_X_FORWARDED_PROTO'] === 'https') {
    $_SERVER['HTTPS'] = 'on';
}

$env_config = __DIR__ . '/environments/' . WP_ENV . '.php';

if (file_exists($env_config)) {
    require_once $env_config;
}

Config::apply();

/**
 * Bootstrap WordPress
 */
if (!defined('ABSPATH')) {
    define('ABSPATH', $webroot_dir . '/wp/');
}