{
  "name": "achatainga/bedrock-cli",
  "description": "Universal CLI tool for managing Roots Bedrock WordPress projects",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Bedrock CLI Contributors"
    }
  ],
  "require": {
    "php": ">=8.0",
    "symfony/console": "^6.0|^7.0|^8.0",
    "symfony/process": "^6.0|^7.0|^8.0",
    "symfony/filesystem": "^6.0|^7.0|^8.0",
    "symfony/yaml": "^6.0|^7.0|^8.0"
  },
  "autoload": {
    "psr-4": {
      "Roots\\BedrockCli\\": "src/"
    }
  },
  "bin": [
    "bin/bedrock"
  ],
  "minimum-stability": "stable",
  "require-dev": {
    "phpunit/phpunit": "11.5"
  },
  "scripts": {
    "test": "phpunit --testdox",
    "test:coverage": "phpunit --coverage-html coverage",
    "test:verbose": "phpunit --testdox --verbose"
  }
}
