{
  "name": "roots/bedrock-cli",
  "description": "Universal CLI tool for managing Roots Bedrock WordPress projects",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "Bedrock CLI Contributors"
    }
  ],
  "require": {
    "php": ">=8.0",
    "symfony/console": "^6.0|^7.0",
    "symfony/process": "^6.0|^7.0",
    "symfony/filesystem": "^6.0|^7.0",
    "symfony/yaml": "^6.0|^7.0"
  },
  "autoload": {
    "psr-4": {
      "Roots\\BedrockCli\\": "src/"
    }
  },
  "bin": [
    "bin/bedrock"
  ],
  "minimum-stability": "stable"
}
