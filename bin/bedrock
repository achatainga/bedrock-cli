#!/usr/bin/env php
<?php

// Autoload
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

foreach ($autoloadPaths as $file) {
    if (file_exists($file)) {
        require $file;
        break;
    }
}

use Roots\BedrockCli\Application;

$app = new Application();
$app->run();
